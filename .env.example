APP_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string-here-min-32-chars

DATA_DIR=./data
BIND_HOST=127.0.0.1
PORT=3000

# LLM providers (model names come from config/ai.json)
GEMINI_API_KEY=            # aistudio.google.com → Get API key (NOT the Gemini app subscription)
GROQ_API_KEY=              # console.groq.com → free, 1000 req/day

# LLM call limits (verify in provider dashboards; enforced by llm_usage counter)
LLM_CALLS_PER_VIDEO=8
GEMINI_DAILY_LIMIT=        # fill from AI Studio project quota page
GROQ_DAILY_LIMIT=1000

# Rendering (Mac Mini M4: 10 cores)
RENDER_CONCURRENCY=3       # for preview; final render is always concurrency=1
MAX_DISK_GB=20

# Publisher (see docs/YTAGENT_INTEGRATION.md)
PUBLISH_MODE=http          # http | folder | manual
YTAGENT_BASE_URL=http://127.0.0.1:8000
YTAGENT_CHANNEL_NAME=      # channel name as configured in ytagent
YTAGENT_WATCH_DIR=         # only needed if PUBLISH_MODE=folder

# Telegram notifications & remote review (optional, $0)
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_CHAT_ID=          # your personal Telegram chat ID
APP_BASE_URL=http://127.0.0.1:3000  # e.g. Tailscale IP http://100.x.x.x:3000 for clickable phone links
