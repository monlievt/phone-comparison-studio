{
  "name": "@phone-studio/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-vm-modules dist/main.js",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file=../../.env dist/main.js",
    "migrate": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@phone-studio/core": "*",
    "@phone-studio/ai": "*",
    "@phone-studio/collectors": "*",
    "@phone-studio/publisher": "*",
    "@phone-studio/video": "*",
    "@remotion/renderer": "4.0.542",
    "@remotion/bundler": "4.0.542"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
